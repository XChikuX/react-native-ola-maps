{
  "name": "react-native-india-maps",
  "version": "0.2.0",
  "description": "React Native SDK for India Maps with Mappls (MapMyIndia) APIs, native SDK support, and Expo config plugins",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./plugin": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "plugin",
    "app.plugin.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "bob build",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "expo",
    "india-maps",
    "mappls",
    "mapmyindia",
    "maps",
    "location",
    "routing",
    "geocoding",
    "geofence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XChikuX/react-native-ola-maps.git"
  },
  "author": "XChikuX",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/XChikuX/react-native-ola-maps/issues"
  },
  "homepage": "https://github.com/XChikuX/react-native-ola-maps#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/babel-preset": "^0.80.0",
    "@react-native/eslint-config": "^0.73.1",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.1.0",
    "react-native": "0.80.0",
    "react-native-builder-bob": "^0.30.0",
    "react-test-renderer": "^19.1.0",
    "release-it": "^15.0.0",
    "turbo": "^1.10.7",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "@types/react": "^18.2.44"
  },
  "peerDependencies": {
    "mappls-map-react-native": "^2.0.2",
    "react": ">=19.1.0",
    "react-native": ">=0.80.0"
  },
  "packageManager": "bun@1.2.0",
  "jest": {
    "preset": "react-native",
    "clearMocks": true,
    "setupFiles": [
      "./test/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native|@maplibre)/)"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "esm": true
        }
      ]
    ]
  },
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "peerDependenciesMeta": {
    "mappls-map-react-native": {
      "optional": false
    },
    "mappls-direction-widget-react-native": {
      "optional": true
    },
    "mappls-geofence-widget-react-native": {
      "optional": true
    },
    "mappls-nearby-widget-react-native": {
      "optional": true
    },
    "mappls-polyline": {
      "optional": true
    },
    "mappls-search-widgets-react-native": {
      "optional": true
    },
    "mappls-tracking-react-native": {
      "optional": true
    }
  }
}
